{
  "name": "dsh-usage-balance-v2",
  "version": "1.1.1",
  "description": "DSH Web 底部用量条内的余额读数与侧边栏工作区累计：本会话消耗、用时、余额、峰谷时段，按工作区汇总",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "usage",
    "peak",
    "off-peak"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3493750852/dsh-usage-balance-v2.git"
  },
  "homepage": "https://github.com/3493750852/dsh-usage-balance-v2#readme",
  "bugs": {
    "url": "https://github.com/3493750852/dsh-usage-balance-v2/issues"
  },
  "author": "Yxkzx",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
